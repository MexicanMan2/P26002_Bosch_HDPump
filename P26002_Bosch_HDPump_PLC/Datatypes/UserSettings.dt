TYPE UserSettings :
	STRUCT
		tLapPulseLen        : TIME              := T#50ms;
		SupplyFuelPumpPIDsettings:  ARRAY [1..3] OF REAL;
		SupplyFuelPump_pressure_tolerance: REAL := 1; (* bar *)
		SupplyFuelPump_temperature_tolerance: REAL := 1; (* °C *)
		OilConditioning_pressure_tolerance: REAL := 5; (* bar *)
		OilConditioning_temperature_tolerance: REAL := 1; (* bar *)
		
		coldStart_oil_pressure: REAL := 1.8; (* bar *)
		coldStart_oil_min_tempterature: REAL := 50; (* °C *)
		coldStart_fuelsupply_pressure: REAL := 2; (* bar *)
		coldStart_fuelsupply_min_tempterature: REAL := 50; (* °C *)
		coldStart_RPM: REAL := 2000; 
		
		normalOperation_oil_pressure: REAL := 2.5;(* bar *)
		normalOperation_fuelsupply_pressure: REAL := 6.0;(* bar *)
	END_STRUCT
END_TYPE
